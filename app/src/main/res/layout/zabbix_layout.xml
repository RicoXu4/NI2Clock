<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<com.google.android.material.card.MaterialCardView style="@style/DashboardCard"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
    <TextView android:id="@+id/cpu_text" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="20dp" android:text="@string/cpu_placeholder" android:textColor="@color/primary"
        android:textAppearance="@style/TextAppearance.Material3.TitleLarge" />
</com.google.android.material.card.MaterialCardView>
<com.google.android.material.card.MaterialCardView style="@style/DashboardCard"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
    <TextView android:id="@+id/ram_text" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="20dp" android:text="@string/ram_placeholder" android:textColor="@color/primary"
        android:textAppearance="@style/TextAppearance.Material3.TitleLarge" />
</com.google.android.material.card.MaterialCardView>
<com.google.android.material.card.MaterialCardView style="@style/DashboardCard"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
    <TextView android:id="@+id/network_text" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="20dp" android:text="@string/network_placeholder" android:textColor="@color/primary"
        android:textAppearance="@style/TextAppearance.Material3.TitleLarge" />
</com.google.android.material.card.MaterialCardView>
</LinearLayout>