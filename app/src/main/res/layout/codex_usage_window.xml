<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" style="@style/DashboardCard"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <TextView android:id="@+id/usage_window_title" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />
        <TextView android:id="@+id/usage_window_percentage" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge" android:textColor="@color/primary" />
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/usage_window_progress" android:layout_width="match_parent"
            android:layout_height="6dp" android:layout_marginTop="12dp" android:max="1000"
            app:trackCornerRadius="3dp" app:trackThickness="6dp" />
        <TextView android:id="@+id/usage_window_reset" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
